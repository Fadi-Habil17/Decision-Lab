PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/decisionlab
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=86400
INTERNAL_TOOL_KEY=replace-with-a-long-random-internal-key
# Copy this file to .env inside server/ before starting the backend.
# Optional Nest Observe account credentials. Leave blank for local training.
# Each teammate supplies their own keys if they choose to enable Observe.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
